#!/usr/bin/env python3
"""Bisect a WebKit build-time regression with `git bisect run`.

Given a commit range and a `measure-build-time` benchmark (default: `clean`), find
the commit that introduced a build-time regression. Run with `--help` for usage.

This is a thin entry point; the implementation lives in `buildtime.py` beside it,
which other tools can import to drive a bisect with extra per-commit setup.
"""

import sys
from pathlib import Path

import buildtime

if __name__ == '__main__':
    sys.exit(buildtime.main(entry_script=Path(__file__).resolve()))
