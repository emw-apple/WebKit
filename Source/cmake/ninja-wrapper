#!/usr/bin/perl
use strict;
use warnings;
use Cwd qw(getcwd);
use File::Path qw(make_path);
use POSIX qw(mkfifo);

chomp(my $ninja = `which ninja 2>/dev/null` || `xcrun -f ninja`);

# CMake configuration
if (grep({ /^-t/ || /^--version$/ } @ARGV)) {
    # CMake ends every generate with "<make program> -C <build dir> -t restat ...".
    # It used to run "-t cleandead" around there too, but no longer does, so do it
    # ourselves. Restatting afterwards then fixes up the
    # log entries for whatever we just removed.
    my ($toolIndex) = grep({ $ARGV[$_] eq '-t' } 0 .. $#ARGV);
    my $isRestat = defined($toolIndex) && ($ARGV[$toolIndex + 1] // '') eq 'restat';

    # CMake runs us from wherever it was invoked, not from the build directory, so
    # cleandead has to be told where to look. try_compile scratch builds get their
    # own restat; skip those, they are disposable.
    my $buildDir;
    for my $i (0 .. $#ARGV) {
        $buildDir = $ARGV[$i + 1], last if $ARGV[$i] eq '-C';
        $buildDir = $1, last if $ARGV[$i] =~ /^-C(.+)$/;
    }
    my $isScratch = getcwd() =~ m{/CMakeFiles/} || ($buildDir // '') =~ m{/CMakeFiles/};

    if ($isRestat && !$isScratch && !$ENV{WK_DISABLE_CLEANDEAD} && !grep({ /^-f/ } @ARGV)) {
        my $dirArg = defined($buildDir) ? "-C \"$buildDir\"" : "";
        my $cleanDead = `"$ninja" $dirArg -v -t cleandead 2>&1`;
        # Report errors to the tty and a log, and then allow restat to continue
        # as normal.
        if ($?) {
            my $message = "ninja-wrapper: cleandead failed:\n$cleanDead";
            if (open(my $fh, '>', "$buildDir/cleandead.log")) {
                print($fh $message);
                close($fh);
            }
            print(STDERR $message);
            if (open(my $tty, '>', '/dev/tty')) {
                print($tty $message);
                close($tty);
            }
        }
    }
    exec($ninja, @ARGV);
}

# CMake try_compile/check_*
if (getcwd() =~ m{/CMakeFiles/}) {
    exec($ninja, @ARGV);
}

# Real compilation
my $bundlePolicy = $ENV{WK_UNIFIED_SOURCES_BUNDLE_POLICY};
if (!defined($bundlePolicy)) {
    my $dryRun = `$ninja -n @ARGV 2>&1`;
    my ($totalCommands) = $dryRun =~ m{/(\d+)\]};

    # No-op build
    if (!defined($totalCommands)) {
        print($dryRun);
        exit($? >> 8);
    }

    if ($dryRun =~ /\bRe-running CMake\b/) {
        $bundlePolicy = "Bundle";
    } elsif ($totalCommands > 8) {
        $bundlePolicy = "Bundle";
    } else {
        $bundlePolicy = "NoBundle";
    }

    $ENV{WK_UNIFIED_SOURCES_BUNDLE_POLICY} = $bundlePolicy;
}

# Record the bundle policy for inspection; nothing reads this file.
make_path("DerivedSources");
if (open(my $fh, '>', "DerivedSources/unified-sources-bundle-policy")) {
    print($fh $bundlePolicy);
    close($fh);
}

print('ninja: Entering directory `' . getcwd() . "'\n");

# GNU Make jobserver. Ninja implements only the client half of the protocol
# (https://www.gnu.org/software/make/manual/html_node/POSIX-Jobserver.html), so
# the pool of job slots has to be owned by whoever invoked it. Hosting it here
# puts the top-level ninja and every nested ninja that clang-wrapper starts on
# one shared set of slots, instead of letting each one pick its own -j and
# oversubscribe the machine.
#
# Ninja disables its client when -j is on its command line, so -j is taken as
# the size of the pool rather than forwarded.
my $jobserverPipe;
my $jobserverFifo;
END {
    unlink($jobserverFifo) if $jobserverFifo;
}

my @ninjaArgs;
my $jobs;
for (my $i = 0; $i <= $#ARGV; ++$i) {
    $jobs = $ARGV[++$i], next if $ARGV[$i] eq '-j';
    $jobs = $1, next if $ARGV[$i] =~ /^-j(\d+)$/;
    push(@ninjaArgs, $ARGV[$i]);
}
my $hasJobserver = startJobserver($jobs);
push(@ninjaArgs, "-j$jobs") if !$hasJobserver && defined($jobs);

my @command = ('/usr/bin/caffeinate', '-i', $ninja, @ninjaArgs);
exec(@command) if !$hasJobserver;

# Stay alive alongside ninja: the pool only exists as long as this process
# holds the fifo open, and the fifo has to be removed afterwards. Ctrl-C
# already reaches ninja on its own (same process group); forwarding covers a
# signal aimed at this process by pid, which used to land on caffeinate back
# when this was an exec. Forwarding rather than ignoring also matters because
# exec resets caught signals to the default in the child, but an ignored signal
# would be inherited.
my $child;
$SIG{$_} = sub { kill($_[0], $child) if $child } foreach qw(INT TERM HUP);
$child = fork() // die("ninja-wrapper: fork: $!\n");
if (!$child) {
    exec(@command);
    die("ninja-wrapper: exec $ninja: $!\n");
}
1 while waitpid($child, 0) < 0 && $!{EINTR};
exit(($? & 127) ? 128 + ($? & 127) : $? >> 8);

# Fill a fifo with job slot tokens and point MAKEFLAGS at it. Returns false,
# leaving the caller to run ninja unchanged, if a pool can't or shouldn't be
# built.
sub startJobserver
{
    my ($jobs) = @_;
    return 0 if $ENV{WK_DISABLE_JOBSERVER};

    # Ninja's own default (processors + 2); ask for it rather than guessing at
    # it a second time here.
    ($jobs) = `"$ninja" --help 2>&1` =~ /-j N .*\[default=(\d+)/ if !defined($jobs);
    return 0 if !$jobs || $jobs < 2;

    (my $tmp = $ENV{TMPDIR} || '/tmp') =~ s{/$}{};
    my $path = "$tmp/webkit-jobserver.$$";
    unlink($path);
    mkfifo($path, 0600) or return 0;

    # '+<' is O_RDWR, the one way to open a fifo without blocking on a peer.
    # This handle is deliberately never closed -- it is what keeps the tokens
    # buffered and lets clients open the write end -- so it has to autoflush.
    if (!open($jobserverPipe, '+<', $path)) {
        unlink($path);
        return 0;
    }
    $jobserverPipe->autoflush(1);
    $jobserverFifo = $path;

    # Each client may run one job on an implicit slot it is never handed, so
    # the pool holds the other N - 1. Any byte is a token; '+' is the one GNU
    # Make and ninja write.
    print($jobserverPipe '+' x ($jobs - 1));

    $ENV{MAKEFLAGS} = "-j$jobs --jobserver-auth=fifo:$path";
    return 1;
}
